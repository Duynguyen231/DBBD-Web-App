# Database (must match docker-compose.yml credentials)
DATABASE_URL="postgresql://duongbo:duongbo_secret@localhost:5432/duongbo_db?schema=public"

# JWT
JWT_SECRET="duongbo_jwt_secret_change_in_production"
JWT_EXPIRES_IN="7d"

# Initial admin account (used by prisma seed)
ADMIN_EMAIL="admin@duongbo.com"
ADMIN_PASSWORD="Admin@123456"

# App
PORT=4000
APP_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL="https://your-public-bucket-domain.r2.dev"

# File upload constraints
MAX_FILE_SIZE=10485760
