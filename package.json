{
  "name": "duong-bo-binh-dinh",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "setup": "node scripts/setup.mjs",
    "db:push": "pnpm --filter api exec prisma db push",
    "db:generate": "pnpm --filter api exec prisma generate",
    "db:studio": "pnpm --filter api exec prisma studio",
    "db:reset": "docker compose down -v && docker compose up -d --wait && pnpm db:push"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
